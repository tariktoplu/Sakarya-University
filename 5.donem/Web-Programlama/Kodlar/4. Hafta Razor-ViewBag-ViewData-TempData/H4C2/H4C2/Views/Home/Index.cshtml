@{
    int x = 5;
    string ders = "Web Programlama";
    string[] ogrenciler = { "Ali", "Gül", "Hasan", "Veli" };
    int bayrak = 1;
    int j = 0;
    int day = (int)DateTime.Now.DayOfWeek;
    string dayString = "";
    string[] days = { "pazar", "Pazartesi", "Salı", "carsamba", "persembe", "cuma", "cumartesi", "pazar" };
}

<div class="text-center">
    <b>@ders</b>
</div>

<table class="table table-striped">
    <tr>
        <td>Saat</td>
        <td>Dakika</td>
        <td>Saniye</td>
    </tr>
    <tr>
        <td>@DateTime.Now.Hour</td>
        <td>@DateTime.Now.Minute</td>
        <td>@DateTime.Now.Second</td>
    </tr>
</table>

<ul>
@for(int i = 1; i < 11; i++)
{
   <li>@i</li>

}
</ul>

<br />
<ol>
@for(int i=0;i<ogrenciler.Length;i++){
        <li>@ogrenciler[i]</li>
    }
</ol>
<br />

@if (bayrak!=0)
{
    @foreach(string ogr in ogrenciler){
        <div>@ogr</div>
    }

}
else
{
    <div>Herhangi bir öğrenci Yok</div>
}
<h5>While ile</h5>
@if (bayrak != 0)
{
    while (j < ogrenciler.Length)
    {
        <div>@ogrenciler[j]</div>
        j++;
    }
    j = 0;
}
else
{
    <div>Herhangi bir öğrenci Yok</div>
}

@while(bayrak!=0 && j < ogrenciler.Length)
{
    <div>@ogrenciler[j]</div>
    j++;
    
} 

<br />
<h5>Haftanın Günü</h5>
@switch (day)
{
  
    case 1:
        dayString = "Pazartesi";
        break;
    case 2:
        dayString = "Salı";
        break;
    case 3:
        dayString = "Çarşamba";
        break;
    case 4:
        dayString = "Perşembe";
        break;
    case 5:
        dayString = "Cuma";
        break;
    default:
        dayString = "Hafta Sonu";
        break;
  
}
<div>@dayString</div>
<div>@days[day]</div>
