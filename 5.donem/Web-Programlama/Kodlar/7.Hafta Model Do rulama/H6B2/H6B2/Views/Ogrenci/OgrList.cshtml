@model IEnumerable<H6B2.Models.Ogrenci>

<div class="alert-danger">@TempData["msj"]</div>
@if (Model.Count() < 1)
{
    <div style="text-align:center" class="alert-info">Herhangi Bir Öğrenci Yok</div>
}else{
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OgrAd)
               
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OgrSoyad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OgrNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OgrMail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OgrYas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OgrDogumTarihi)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.OgrAd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OgrSoyad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OgrNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OgrMail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OgrYas)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OgrDogumTarihi)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
            </td>
        </tr>
}
    </tbody>
</table>
}