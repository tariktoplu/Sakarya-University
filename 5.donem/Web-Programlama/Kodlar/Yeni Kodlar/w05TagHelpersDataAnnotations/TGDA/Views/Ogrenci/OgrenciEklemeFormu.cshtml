@model Ogrenci
@{
    ViewData["Title"] = "Öğrenci Kayıt Formu";
}

<h1> @ViewData["Title"] </h1>

<form asp-action="OgrenciEkle" asp-controller="Ogrenci" method="POST">
    <div class="form-group">
        <label asp-for="OgrenciAd"></label>
        <input asp-for="OgrenciAd" class="form-control" />
        <span asp-validation-for="OgrenciAd" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OgrenciSoyad"></label>
        <input asp-for="OgrenciSoyad" class="form-control" />
        <span asp-validation-for="OgrenciSoyad" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OgrenciNumara"></label>
        <input asp-for="OgrenciNumara" class="form-control" />
        <span asp-validation-for="OgrenciNumara" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OgrenciYas"></label>
        <input asp-for="OgrenciYas" class="form-control" />
        <span asp-validation-for="OgrenciYas" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OgrenciMail"></label>
        <input asp-for="OgrenciMail" class="form-control" />
        <span asp-validation-for="OgrenciMail" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OgrenciDogumTarihi"></label>
        <input asp-for="OgrenciDogumTarihi" class="form-control" />
        <span asp-validation-for="OgrenciDogumTarihi" class="text-danger"></span>
    </div>
    <input type="submit" value="K A Y D E T" class="btn btn-success"/> 
</form>

@section Scripts {
@{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}