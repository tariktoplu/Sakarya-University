<h3>Öğrenci Ekleme Modülü</h3>

  <form action="..\Ogrenci\OgrKaydetClassAll" method="post" >
     

        <div class="mb-3">
            <label for="OgrAd" class="form-label fw-semibold">Öğrenci Adı</label>
            <input type="text" class="form-control" id="OgrAd" name="OgrAd" placeholder="Adınızı giriniz" >
        </div>

            <div class="mb-3">
            <label for="OgrSoyad" class="form-label fw-semibold">Öğrenci Soyadı</label>
            <input type="text" class="form-control" id="OgrSoyad" name="OgrSoyad" placeholder="Soyadınızı giriniz" >
        </div>

        <div class="mb-3">
            <label for="OgrNo" class="form-label fw-semibold">Öğrenci No</label>
            <input type="text" class="form-control" id="OgrNo" name="OgrNo" placeholder="Öğrenci numaranızı giriniz" >
        </div>

        <div class="d-grid">
            <button type="submit" class="btn btn-primary">Kaydet</button>
        </div>
    </form>